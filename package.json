{
  "name": "intensicare-v2",
  "private": true,
  "version": "0.0.0",
  "description": "IntensiCare V2 — copiloto do intensivista para deterioração clínica. Monorepo pnpm (fundações executáveis, SPR-G7-1).",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test -- --run",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome ci --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "check:boundaries": "node scripts/check_module_boundaries.mjs",
    "check:docs": "python3 scripts/check_doc_conventions.py",
    "check:forbidden": "python3 scripts/check_forbidden_content.py",
    "check:contratos": "node scripts/check_contratos.mjs && node scripts/check_contratos.mjs autoteste",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm test && pnpm check:generated && pnpm check:contratos && pnpm check:docs && pnpm check:forbidden",
    "check:generated": "node scripts/check_generated_files.mjs",
    "test:fronteira": "IC_FRONTEIRA_PG=obrigatoria pnpm --filter @intensicare/persistencia test:fronteira",
    "test:e2e": "pnpm --filter @intensicare/web test:e2e",
    "test:e2e:instalar": "pnpm --filter @intensicare/web test:e2e:instalar",
    "check:supply-chain": "node scripts/verificar-artefato.mjs tudo",
    "sbom": "node scripts/verificar-artefato.mjs sbom --filtro @intensicare/api --saida evidencia/sbom-api.json",
    "promover": "node scripts/promover-por-digest.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "22.20.1",
    "fast-check": "4.9.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
