{
  "name": "intensicare-v2",
  "private": true,
  "version": "0.0.0",
  "description": "IntensiCare V2 — copiloto do intensivista para deterioração clínica. Monorepo pnpm (fundações executáveis, SPR-G7-1).",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test -- --run",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check:docs": "python3 scripts/check_doc_conventions.py",
    "check:forbidden": "python3 scripts/check_forbidden_content.py"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "fast-check": "4.9.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
