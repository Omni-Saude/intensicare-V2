{
  "name": "@intensicare/fixtures-sinteticas",
  "version": "0.0.0",
  "private": true,
  "description": "Geração de dados 100% sintéticos (SYNTH-) para desenvolvimento e teste do IntensiCare V2.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@intensicare/dominio": "workspace:*",
    "@intensicare/persistencia": "workspace:*"
  },
  "devDependencies": {}
}
