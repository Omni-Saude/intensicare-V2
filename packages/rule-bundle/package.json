{
  "name": "@intensicare/rule-bundle",
  "version": "0.0.0",
  "private": true,
  "description": "Pacote de release clínico assinável — formato de bundle imutável, assinatura, aprovação autor≠aprovador, ativação, rollback e retirada (ADR-0007).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@intensicare/kernel-clinico": "workspace:*",
    "@intensicare/dominio": "workspace:*"
  }
}
