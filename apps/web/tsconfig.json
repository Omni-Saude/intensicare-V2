{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["vite/client"]
  },
  // `e2e` entra no typecheck de propósito: código de teste não verificado é
  // onde defeitos se escondem, e a suíte de navegador é a única prova de
  // vários critérios WCAG desta fatia. `playwright.config.ts` fica de fora
  // porque usa `process.env`, e este app não declara os tipos do Node.
  "include": ["src", "e2e"]
}
