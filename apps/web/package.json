{
  "name": "@intensicare/web",
  "version": "0.0.0",
  "private": true,
  "description": "Frontend do IntensiCare V2 (React 18 + Vite, pt-BR clínico, WCAG 2.2 AA como requisito de projeto).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:instalar": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@intensicare/contratos": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "vite": "8.2.1"
  }
}
